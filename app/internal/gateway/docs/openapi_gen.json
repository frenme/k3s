{
  "components": {
    "schemas": {
      "AppConfig": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "key",
          "value"
        ],
        "type": "object"
      },
      "Check": {
        "additionalProperties": false,
        "properties": {
          "details": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "error": {
            "type": "string"
          },
          "healthy": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "service",
              "infra"
            ],
            "type": "string"
          },
          "latency_ms": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "healthy",
          "latency_ms"
        ],
        "type": "object"
      },
      "CreateOrderRequestBody": {
        "additionalProperties": false,
        "properties": {
          "amount_cents": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "item": {
            "maxLength": 200,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "item",
          "amount_cents"
        ],
        "type": "object"
      },
      "CreateUserRequestBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "email",
          "name"
        ],
        "type": "object"
      },
      "DetailsResponseBody": {
        "additionalProperties": false,
        "properties": {
          "checked_at": {
            "format": "date-time",
            "type": "string"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/Check"
            },
            "nullable": true,
            "type": "array"
          },
          "status": {
            "enum": [
              "ok",
              "unhealthy"
            ],
            "type": "string"
          }
        },
        "required": [
          "checked_at",
          "checks",
          "status"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "items": {
              "type": "string"
            },
            "nullable": true,
            "type": "array"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "Job": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "next_run": {
            "format": "date-time",
            "type": "string"
          },
          "schedule": {
            "type": "string"
          },
          "timeout_seconds": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "schedule",
          "timeout_seconds",
          "next_run"
        ],
        "type": "object"
      },
      "ListAppConfigResponseBody": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AppConfig"
            },
            "nullable": true,
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ListJobsResponseBody": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Job"
            },
            "nullable": true,
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Order": {
        "additionalProperties": false,
        "properties": {
          "amount_cents": {
            "format": "int64",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "item": {
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "user_id",
          "item",
          "amount_cents",
          "created_at"
        ],
        "type": "object"
      },
      "PageOrder": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Order"
            },
            "nullable": true,
            "type": "array"
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "PageUser": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/User"
            },
            "nullable": true,
            "type": "array"
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "RolesBody": {
        "additionalProperties": false,
        "properties": {
          "roles": {
            "items": {
              "type": "string"
            },
            "nullable": true,
            "type": "array"
          }
        },
        "required": [
          "roles"
        ],
        "type": "object"
      },
      "Run": {
        "additionalProperties": false,
        "properties": {
          "duration_ms": {
            "format": "int64",
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "job": {
            "type": "string"
          },
          "status": {
            "enum": [
              "succeeded",
              "failed"
            ],
            "type": "string"
          }
        },
        "required": [
          "job",
          "status",
          "duration_ms"
        ],
        "type": "object"
      },
      "StatusBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ok",
              "unhealthy"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "User": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "created_at"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
