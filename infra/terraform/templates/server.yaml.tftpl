#cloud-config
ssh_pwauth: false
package_update: true
package_upgrade: true
packages:
  - unattended-upgrades
write_files:
  - path: /etc/rancher/k3s/config.yaml
    permissions: "0600"
    content: |
      token: ${token}
      agent-token: ${agent_token}
      cluster-init: true
      flannel-backend: wireguard-native
      write-kubeconfig-mode: "0600"
      secrets-encryption: true
      node-label:
%{ if edge ~}
        - role=edge
        - svccontroller.k3s.cattle.io/enablelb=true
%{ else ~}
        - role=core
%{ endif ~}
      etcd-snapshot-schedule-cron: "0 */6 * * *"
      etcd-snapshot-retention: 28
%{ if s3 != null ~}
      etcd-s3: true
      etcd-s3-endpoint: ${s3.endpoint}
      etcd-s3-bucket: ${s3.bucket}
      etcd-s3-folder: ${s3.folder}
      etcd-s3-access-key: ${s3.access_key}
      etcd-s3-secret-key: ${s3.secret_key}
%{ endif ~}
%{ if registry != null ~}
  - path: /etc/rancher/k3s/registries.yaml
    permissions: "0600"
    content: |
      configs:
        ${jsonencode(registry.host)}:
          auth:
            username: ${jsonencode(registry.username)}
            password: ${jsonencode(registry.password)}
%{ endif ~}
runcmd:
  - curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION=${k3s_version} sh -s - server
