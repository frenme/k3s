instances: {{ .Values.postgres.instances }}

pooler:
  enabled: {{ .Values.postgres.pooler.enabled }}
  instances: {{ .Values.postgres.pooler.instances }}

services:
  {{- range $name, $app := .Values.apps }}
  {{- if and (not (dig "gateway" false $app)) (dig "database" true $app) }}
  {{ $name }}:
    password: {{ required (printf "secrets.postgres.%s must be set" $name) (dig $name "" $.Values.secrets.postgres) | quote }}
    readAllSchemas: {{ dig "readAllSchemas" false $app }}
  {{- end }}
  {{- end }}

{{- if dig "backups" false .Values }}

backup:
  enabled: true
  {{- with dig "backupServerName" "" .Values.postgres }}
  serverName: {{ . }}
  {{- end }}
  destinationPath: s3://{{ .Values.s3.bucket }}/{{ .Environment.Name }}/
  endpointURL: https://{{ .Values.s3.endpoint }}
  accessKeyId: {{ .Values.secrets.s3.accessKeyId | quote }}
  secretAccessKey: {{ .Values.secrets.s3.secretAccessKey | quote }}
{{- end }}
