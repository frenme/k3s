environments:
  local:
    values:
      - environments/common.yaml
      - environments/local.yaml
  dev:
    values:
      - environments/common.yaml
      - environments/dev.yaml
      - environments/secrets.yaml.gotmpl
  prod:
    values:
      - environments/common.yaml
      - environments/prod.yaml
      - environments/secrets.yaml.gotmpl

---

repositories:
  - name: jetstack
    url: https://charts.jetstack.io
  - name: cnpg
    url: https://cloudnative-pg.github.io/charts
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: kubereboot
    url: https://kubereboot.github.io/charts
  - name: grafana
    url: https://grafana.github.io/helm-charts
  - name: grafana-community
    url: https://grafana-community.github.io/helm-charts
  - name: rancher-charts
    url: https://charts.rancher.io

helmDefaults:
  kubeContext: {{ .Values.kubeContext }}
  wait: true
  timeout: 600
  createNamespace: true

missingFileHandler: Debug

{{- $local := eq .Environment.Name "local" }}
{{- $backups := dig "backups" false .Values }}
{{- $registry := env "REGISTRY" | default "k3s-base" }}
{{- $tag := env "TAG" | default "dev" }}
{{- if and (not $local) (or (eq $registry "k3s-base") (eq $tag "dev")) }}
{{- fail (printf "environment %s needs REGISTRY and TAG" .Environment.Name) }}
{{- end }}

{{- $appSchema := (readFile "environments/apps.schema.json" | fromJson).definitions.app.properties }}
{{- range $name, $app := .Values.apps }}
{{- if not (kindIs "map" $app) }}
{{- fail (printf "apps.%s must be a map, write `%s: {}` for a service without settings" $name $name) }}
{{- end }}
{{- range $key, $value := $app }}
{{- if not (hasKey $appSchema $key) }}
{{- fail (printf "apps.%s: unknown key %q, allowed: %s (see environments/apps.schema.json)" $name $key (join ", " (keys $appSchema | sortAlpha))) }}
{{- end }}
{{- if and (eq (index (index $appSchema $key) "type") "boolean") (not (kindIs "bool" $value)) }}
{{- fail (printf "apps.%s.%s must be true or false, got %v" $name $key $value) }}
{{- end }}
{{- end }}
{{- end }}

templates:
  layered:
    namespace: {{ .Values.namespace }}
    values:
      - values/base/{{`{{ .Release.Name }}`}}.yaml
      - values/{{`{{ .Environment.Name }}`}}/{{`{{ .Release.Name }}`}}.yaml
      - values/derived/{{`{{ .Release.Name }}`}}.yaml.gotmpl
  app:
    inherit:
      - template: layered
    chart: ./helm/service
    values:
      - values/derived/app.yaml.gotmpl

releases:
  - name: monitoring
    namespace: monitoring
    inherit:
      - template: layered
    chart: prometheus-community/kube-prometheus-stack
    version: 92.10.1

  - name: loki
    namespace: monitoring
    inherit:
      - template: layered
    chart: grafana-community/loki
    version: 19.1.1
    needs:
      - monitoring/monitoring

  - name: tempo
    installed: {{ .Values.telemetry.traces }}
    namespace: monitoring
    inherit:
      - template: layered
    chart: grafana-community/tempo
    version: 3.2.1
    needs:
      - monitoring/monitoring

  - name: alloy
    namespace: monitoring
    inherit:
      - template: layered
    chart: grafana/alloy
    version: 1.14.2
    needs:
      - monitoring/loki

  - name: kured
    namespace: kube-system
    inherit:
      - template: layered
    chart: kubereboot/kured
    version: 6.1.0

  - name: system-upgrade-controller
    namespace: cattle-system
    inherit:
      - template: layered
    chart: rancher-charts/system-upgrade-controller
    version: 110.0.0

  - name: cert-manager
    installed: {{ $backups }}
    namespace: cert-manager
    inherit:
      - template: layered
    chart: jetstack/cert-manager
    version: v1.21.2

  - name: cnpg
    namespace: cnpg-system
    inherit:
      - template: layered
    chart: cnpg/cloudnative-pg
    version: 0.29.1

  - name: barman-cloud
    installed: {{ $backups }}
    namespace: cnpg-system
    inherit:
      - template: layered
    chart: cnpg/plugin-barman-cloud
    version: 0.8.1
    needs:
      - cert-manager/cert-manager
      - cnpg-system/cnpg

  - name: postgres
    inherit:
      - template: layered
    chart: ./helm/postgres
    needs:
      - cnpg-system/cnpg
      - monitoring/monitoring
      {{- if $backups }}
      - cnpg-system/barman-cloud
      {{- end }}

  - name: redis
    inherit:
      - template: layered
    chart: ./helm/redis
    needs:
      - monitoring/monitoring

{{- range $name, $app := .Values.apps }}

  - name: {{ $name }}
    inherit:
      - template: app
    {{- if dig "gateway" false $app }}
    timeout: 180
    {{- end }}
    needs:
      - monitoring/monitoring
      {{- if and (not (dig "gateway" false $app)) (dig "database" true $app) }}
      - postgres
      {{- end }}
      {{- if and (not (dig "gateway" false $app)) (dig "redis" true $app) }}
      - redis
      {{- end }}
{{- end }}

  - name: platform
    namespace: kube-system
    inherit:
      - template: layered
    chart: ./helm/platform
    needs:
      - monitoring/monitoring
      - cattle-system/system-upgrade-controller
