environments:
  local:
    values:
      - environments/common.yaml
      - environments/local.yaml
  dev:
    values:
      - environments/common.yaml
      - environments/dev.yaml
      - environments/secrets.yaml.gotmpl
  prod:
    values:
      - environments/common.yaml
      - environments/prod.yaml
      - environments/secrets.yaml.gotmpl

---

repositories:
  - name: jetstack
    url: https://charts.jetstack.io
  - name: cnpg
    url: https://cloudnative-pg.github.io/charts
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: kubereboot
    url: https://kubereboot.github.io/charts
  - name: grafana
    url: https://grafana.github.io/helm-charts
  - name: grafana-community
    url: https://grafana-community.github.io/helm-charts
  - name: rancher-charts
    url: https://charts.rancher.io

helmDefaults:
  kubeContext: {{ .Values.kubeContext }}
  wait: true
  timeout: 600
  createNamespace: true

missingFileHandler: Debug

{{- $local := eq .Environment.Name "local" }}
{{- $registry := env "REGISTRY" | default "k3s-base" }}
{{- $tag := env "TAG" | default "dev" }}
{{- if and (not $local) (or (eq $registry "k3s-base") (eq $tag "dev")) }}
{{- fail (printf "environment %s needs REGISTRY and TAG" .Environment.Name) }}
{{- end }}

templates:
  layered:
    namespace: {{ .Values.namespace }}
    values:
      - values/base/{{`{{ .Release.Name }}`}}.yaml
      - values/{{`{{ .Environment.Name }}`}}/{{`{{ .Release.Name }}`}}.yaml
      - values/derived/{{`{{ .Release.Name }}`}}.yaml.gotmpl
  telemetry:
    namespace: monitoring
    values:
      - values/base/{{`{{ .Release.Name }}`}}.yaml
      - values/{{`{{ .Environment.Name }}`}}/{{`{{ .Release.Name }}`}}.yaml
      - values/derived/{{`{{ .Release.Name }}`}}.yaml.gotmpl
  app:
    inherit:
      - template: layered
    chart: ./helm/service
    needs:
      - postgres
      - redis
      - monitoring/monitoring
    values:
      - values/derived/app.yaml.gotmpl
      - values/image.yaml.gotmpl

releases:
  - name: monitoring
    inherit:
      - template: telemetry
    chart: prometheus-community/kube-prometheus-stack
    version: 92.10.1

  - name: loki
    inherit:
      - template: telemetry
    chart: grafana-community/loki
    version: 19.1.1
    needs:
      - monitoring/monitoring

  - name: tempo
    inherit:
      - template: telemetry
    chart: grafana-community/tempo
    version: 3.2.1
    needs:
      - monitoring/monitoring

  - name: alloy
    inherit:
      - template: telemetry
    chart: grafana/alloy
    version: 1.14.2
    needs:
      - monitoring/loki

  - name: observability
    namespace: monitoring
    chart: ./helm/observability
    values:
      - values/derived/observability.yaml.gotmpl
    needs:
      - monitoring/monitoring

  - name: kured
    namespace: kube-system
    chart: kubereboot/kured
    version: 6.1.0
    values:
      - values/base/kured.yaml

  - name: system-upgrade-controller
    namespace: cattle-system
    chart: rancher-charts/system-upgrade-controller
    version: 110.0.0

  - name: upgrades
    namespace: cattle-system
    chart: ./helm/upgrades
    values:
      - values/derived/upgrades.yaml.gotmpl
    needs:
      - cattle-system/system-upgrade-controller
      - {{ .Values.namespace }}/gateway

  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: v1.21.2
    set:
      - name: crds.enabled
        value: true

  - name: cnpg
    namespace: cnpg-system
    chart: cnpg/cloudnative-pg
    version: 0.29.1

  - name: barman-cloud
    namespace: cnpg-system
    chart: cnpg/plugin-barman-cloud
    version: 0.8.1
    needs:
      - cert-manager/cert-manager
      - cnpg-system/cnpg

  - name: cluster
    namespace: kube-system
    chart: ./helm/cluster
    values:
      - values/derived/cluster.yaml.gotmpl
    needs:
      - cert-manager/cert-manager

  - name: postgres
    inherit:
      - template: layered
    chart: ./helm/postgres
    needs:
      - cnpg-system/barman-cloud
      - monitoring/monitoring

  - name: redis
    inherit:
      - template: layered
    chart: ./helm/redis
    needs:
      - monitoring/monitoring

{{- range $name, $_ := .Values.apps }}

  - name: {{ $name }}
    inherit:
      - template: app
{{- end }}
