instances: {{ .Values.postgres.instances }}

services:
  {{- range $name, $app := .Values.apps }}
  {{- if dig "database" false $app }}
  {{ $name }}:
    password: {{ required (printf "secrets.postgres.%s must be set" $name) (dig $name "" $.Values.secrets.postgres) | quote }}
  {{- end }}
  {{- end }}

backup:
  enabled: true
  serverName: {{ dig "backupServerName" "" .Values.postgres | quote }}
  destinationPath: {{ .Values.backup.destinationPath }}
  endpointURL: {{ .Values.backup.endpointURL }}
  accessKeyId: {{ .Values.secrets.s3.accessKeyId | quote }}
  secretAccessKey: {{ .Values.secrets.s3.secretAccessKey | quote }}
