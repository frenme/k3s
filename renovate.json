{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/infra/deploy/helm/.+/values\\.yaml$/",
        "/^Makefile$/"
      ],
      "matchStrings": [
        "(image|--image)[:=] ?\"?(?<depName>[a-z0-9./_-]+):(?<currentValue>[A-Za-z0-9._-]+)\"?",
        "_IMAGE := (?<depName>[a-z0-9./_-]+):(?<currentValue>[A-Za-z0-9._-]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/infra/terraform/variables\\.tf$/",
        "/infra/deploy/environments/.+\\.yaml$/"
      ],
      "matchStrings": [
        "default = \"(?<currentValue>v[0-9.]+\\+k3s[0-9]+)\"",
        "k3sVersion: (?<currentValue>v[0-9.]+\\+k3s[0-9]+)"
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.yaml$/"
      ],
      "matchStrings": [
        "golangci-lint-action@\\S+\\s+with:\\s+version: (?<currentValue>v[0-9.]+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "postgres",
        "ghcr.io/cloudnative-pg/postgresql",
        "redis"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "go modules"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "github actions"
    },
    {
      "matchPackageNames": [
        "k3s-io/k3s"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "dependencyDashboardApproval": true
    }
  ],
  "ignoreDeps": [
    "k3s-base/service"
  ]
}
